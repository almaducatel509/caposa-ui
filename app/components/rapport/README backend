## 🗄️ Modèle Django suggéré

```python
# models.py
import uuid
from django.db import models
from django.contrib.auth import get_user_model

User = get_user_model()

class Report(models.Model):
    TYPES = [
        ("liquidite", "Liquidité"),
        ("solvabilite", "Solvabilité"),
        ("conformite", "Conformité"),
        ("prets_souffrance", "Prêts en souffrance"),
    ]

    STATUTS = [
        ("conforme", "Conforme"),
        ("alerte", "À surveiller"),
        ("critique", "Critique"),
    ]

    ETATS = [
        ("actif", "Actif"),
        ("archive", "Archivé"),
    ]

    id = models.UUIDField(primary_key=True, default=uuid.uuid4, editable=False)
    type = models.CharField(max_length=30, choices=TYPES)
    nom = models.CharField(max_length=100, blank=True)
    reference = models.CharField(max_length=50, unique=True)

    filtres = models.JSONField()              # period_libelle, date_debut, date_fin, …
    snapshot = models.JSONField()             # 📸 Données figées (NE JAMAIS recalculer)

    statut = models.CharField(max_length=20, choices=STATUTS)
    etat = models.CharField(max_length=20, choices=ETATS, default="actif")

    genere_par = models.ForeignKey(User, on_delete=models.PROTECT, related_name="rapports")
    genere_le = models.DateTimeField(auto_now_add=True)

    class Meta:
        ordering = ["-genere_le"]
        indexes = [
            models.Index(fields=["type", "genere_le"]),
            models.Index(fields=["etat"]),
            models.Index(fields=["statut"]),
        ]
```

### ⚠️ Points critiques pour l'immuabilité

1. **Bloquer les updates** sur les champs snapshot, filtres, type, statut :
```python
def save(self, *args, **kwargs):
    if self.pk:
        orig = Report.objects.get(pk=self.pk)
        for field in ["snapshot", "filtres", "type", "statut", "reference"]:
            if getattr(orig, field) != getattr(self, field):
                raise ValidationError(f"Le champ {field} est immuable.")
    super().save(*args, **kwargs)
```

2. **Désactiver le DELETE** via les permissions DRF :
```python
http_method_names = ["get", "post", "patch", "head", "options"]
```

