# ==========================================
# Caposa Frontend - Configuration Environnement
# ==========================================

# URL de l'API Django côté serveur (Node.js)
BASE_URL=https://api.caposa.fleuridor.com/api/

# URL de l'API Django côté client (Navigateur)
NEXT_PUBLIC_API_URL=https://api.caposa.fleuridor.com/api/

# Domaine public du frontend pour NextAuth / Auth.js
AUTH_URL=https://caposa.fleuridor.com
NEXTAUTH_URL=https://caposa.fleuridor.com
AUTH_TRUST_HOST=true

# Clé secrète de session NextAuth
AUTH_SECRET=change-me-to-a-very-strong-secret-key
NEXTAUTH_SECRET=change-me-to-a-very-strong-secret-key

# Noms des cookies
NEXT_PUBLIC_TOKEN_NAME=auth_token
NEXT_PUBLIC_REFRESH_TOKEN=refresh_token
TOKEN_NAME=auth_token
REFRESH_TOKEN=refresh_token

# Fuseau horaire
NEXT_PUBLIC_TIMEZONE=America/Port-au-Prince
